{
  "tasks": {
    "dev": "deno run -A node_modules/vite/bin/vite.js",
    "build": "deno run -A node_modules/typescript/bin/tsc -b && deno run -A node_modules/vite/bin/vite.js build",
    "lint": "deno run -A node_modules/eslint/bin/eslint.js .",
    "preview": "deno run -A node_modules/vite/bin/vite.js preview",
    "test": "deno run -A node_modules/vitest/vitest.mjs run --no-file-parallelism",
    "test:coverage": "deno run -A node_modules/vitest/vitest.mjs run --coverage --no-file-parallelism",
    "bench:perf": "deno run -A node_modules/vitest/vitest.mjs run -c vitest.perf.config.ts --no-file-parallelism",
    "format": "deno fmt",
    "format:check": "deno fmt --check"
  },
  "nodeModulesDir": "manual",
  "fmt": {
    "exclude": [
      "patch.js",
      "patch.py",
      "patch_import.py",
      "node_modules",
      "dist"
    ]
  }
}
