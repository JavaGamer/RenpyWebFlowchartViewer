{
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:typescript/tsc -b && deno run -A npm:vite build",
    "lint": "deno run -A npm:eslint .",
    "preview": "deno run -A npm:vite preview",
    "test": "deno run -A --v8-flags=--max-old-space-size=8192 npm:vitest run --no-file-parallelism",
    "test:coverage": "deno run -A --v8-flags=--max-old-space-size=8192 npm:vitest run --coverage --no-file-parallelism",
    "bench:perf": "deno run -A --v8-flags=--max-old-space-size=8192 npm:vitest run -c vitest.perf.config.ts --no-file-parallelism",
    "format": "deno fmt",
    "format:check": "deno fmt --check"
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": [
      "patch.js",
      "patch.py",
      "patch_import.py",
      "node_modules",
      "dist"
    ]
  }
}
